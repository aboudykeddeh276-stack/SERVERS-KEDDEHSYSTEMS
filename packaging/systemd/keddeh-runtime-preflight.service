[Unit]
Description=Validate KEDDEH runtime and module indexes
Before=keddeh-runtime.target keddeh-module@.service

[Service]
Type=oneshot
User=keddeh
Group=keddeh
ExecStart=/usr/bin/python3 /opt/keddeh/SERVERS-KEDDEHSYSTEMS/packaging/bin/keddeh-index.py --root /opt/keddeh/SERVERS-KEDDEHSYSTEMS --receipt /var/lib/keddeh/index-verification.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/keddeh
