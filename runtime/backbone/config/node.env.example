# Copy to /etc/keddeh/backbone/<node-id>.env and bind real host values.
# Never commit production secrets or private keys.

KEX_NODE_ID=alpha-production
KEX_MESH_BIND=0.0.0.0
KEX_MESH_PORT=16001
KEX_DNS_BIND=0.0.0.0
KEX_DNS_PORT=53
KEX_HEARTBEAT_SEC=10
KEX_STALE_SEC=30

# Persistent state MUST live outside the deployed code tree.
KEX_BACKBONE_STATE=/var/lib/keddeh/backbone/alpha-production
KEX_REGISTRAR_DB=/var/lib/keddeh/domain-authority/keddeh_registrar.sqlite
KEX_SQLITE_BUSY_MS=5000

# Address actually published into the authoritative zone for this node.
# Never use 0.0.0.0, ::, or loopback for a production/public authority record.
KEX_AUTHORITY_IPV4=REPLACE_ON_HOST

# Required. Generate a strong shared secret. Non-loopback mesh also requires mTLS below.
KEX_MESH_SECRET=REPLACE_ON_HOST

# Comma-separated node@host:port entries. Example only.
KEX_MESH_PEERS=beta-production@10.0.0.12:16001,gamma-production@10.0.0.13:16001

# Mandatory for any non-loopback mesh exposure. CA is mandatory, not optional.
KEX_MESH_TLS_CERT=/etc/keddeh/tls/node.crt
KEX_MESH_TLS_KEY=/etc/keddeh/tls/node.key
KEX_MESH_TLS_CA=/etc/keddeh/tls/mesh-ca.crt

# GLOBAL BGP EDGE. Leave unbound until real public resources and upstream/IXP authority exist.
# RFC 8212 fail-closed policy is mandatory.
# KEX_PUBLIC_ASN=
# KEX_BGP_ROUTER_ID=
# KEX_PUBLIC_PREFIXES=
# KEX_BGP_PEERS=peer-ip@remote-asn
# KEX_BGP_IMPORT_PREFIXES=
# KEX_BGP_MAX_PREFIXES=
# KEX_RPKI_RTR_SERVERS=validator-a:3323,validator-b:3323
# KEX_ROA_EVIDENCE=path-or-receipt-ref
