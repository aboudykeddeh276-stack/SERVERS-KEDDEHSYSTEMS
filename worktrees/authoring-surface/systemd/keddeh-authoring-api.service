[Unit]
Description=KEDDEH authenticated authoring API
After=network.target
[Service]
Type=exec
User=keddeh
Group=keddeh
Environment=KEDDEH_AUTHORING_STATE=/var/lib/keddeh/authoring
ExecStart=/usr/bin/python3 /opt/keddeh/SERVERS-KEDDEHSYSTEMS/worktrees/authoring-surface/server.py
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/keddeh/authoring
[Install]
WantedBy=keddeh-runtime.target
