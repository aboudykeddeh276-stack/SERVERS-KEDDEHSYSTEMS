{
  "schema_version": "keddeh.ui-primitive/v1",
  "primitive": "link",
  "version": "1.0.0",
  "html_tag": "a",
  "identity": {
    "required": [
      "artifact_id",
      "revision"
    ],
    "child_links_are_independent": true
  },
  "properties": {
    "text": "string",
    "href": "uri",
    "target": "enum:_self|_blank"
  },
  "allowed_children": [],
  "code_stack": {
    "manifest": "worktrees/primitives/link/primitive.index.json",
    "renderer": "worktrees/primitives/link/render.js",
    "styles": "worktrees/primitives/link/style.css"
  },
  "editing": {
    "admin_required": true,
    "raw_stack_exposed": true,
    "production_write_requires_etag": true
  },
  "security": {
    "arbitrary_eval": false,
    "inline_script": false,
    "unsafe_html": false
  }
}
