{
  "schema_version": "keddeh.ui-primitive/v1",
  "primitive": "learning",
  "version": "1.0.0",
  "html_tag": "article",
  "identity": {
    "required": [
      "artifact_id",
      "revision"
    ],
    "child_links_are_independent": true
  },
  "properties": {
    "learning": "string",
    "source": "string",
    "confidence": "number:0..1"
  },
  "allowed_children": [
    "link"
  ],
  "code_stack": {
    "manifest": "worktrees/primitives/learning/primitive.index.json",
    "renderer": "worktrees/primitives/learning/render.js",
    "styles": "worktrees/primitives/learning/style.css"
  },
  "editing": {
    "admin_required": true,
    "raw_stack_exposed": true,
    "production_write_requires_etag": true
  },
  "security": {
    "arbitrary_eval": false,
    "inline_script": false,
    "unsafe_html": false
  }
}
