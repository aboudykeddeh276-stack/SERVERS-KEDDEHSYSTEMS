{
  "schema_version": "keddeh.ui-primitive/v1",
  "primitive": "claim",
  "version": "1.0.0",
  "html_tag": "article",
  "identity": {
    "required": [
      "artifact_id",
      "revision"
    ],
    "child_links_are_independent": true
  },
  "properties": {
    "claim": "string",
    "basis": "string",
    "status": "enum:draft|supported|verified"
  },
  "allowed_children": [
    "link",
    "learning"
  ],
  "code_stack": {
    "manifest": "worktrees/primitives/claim/primitive.index.json",
    "renderer": "worktrees/primitives/claim/render.js",
    "styles": "worktrees/primitives/claim/style.css"
  },
  "editing": {
    "admin_required": true,
    "raw_stack_exposed": true,
    "production_write_requires_etag": true
  },
  "security": {
    "arbitrary_eval": false,
    "inline_script": false,
    "unsafe_html": false
  }
}
